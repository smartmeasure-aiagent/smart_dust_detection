# Smart Dustbin backend configuration.
# Copy this file to `.env` (same folder) and set your values.
# `.env` is gitignored, so your real key is never committed.

# ---- API key for the programmatic voice API (/api/voice/*) ----
# This is the authorization token the voice-call agent sends as:
#     x-api-key: <token>        OR      Authorization: Bearer <token>
# Leave it blank to keep the voice API open (fine for local testing).
# The browser dashboard does NOT need this key.
API_KEY=

# ---- Optional ----
# Port the server listens on when run with `python app.py` is 5000 (not read from here).
